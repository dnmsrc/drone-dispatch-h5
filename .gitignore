# ────────────────────────────────────────────────
# drone-dispatch-h5（用户端 H5 / 微信小程序）忽略规则
# 原则：源码与文档入库；依赖、构建产物、运行时数据不入库。
# ────────────────────────────────────────────────

# ── 依赖 ──────────────────────────────────────
node_modules/
.pnpm-store/
.pnp.*

# ── 构建产物（uni-app / HBuilderX）────────────────
dist/
unpackage/
*.local

# ── 日志 ──────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── 编辑器 / 系统 ─────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.suo
*.sw?
*.bak
*.orig
