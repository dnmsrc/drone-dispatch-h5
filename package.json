{
  "name": "drone-dispatch-h5",
  "version": "0.1.0",
  "private": true,
  "description": "星穹 SkyShow 无人机派单系统 - 用户端 H5 / 微信小程序（uni-app Vue3 + TypeScript + Vite）",
  "scripts": {
    "dev": "uni",
    "dev:h5": "uni",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"src/**/*.{vue,ts,js,json,css}\" \"*.{ts,js,json,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{vue,ts,js,json,css}\" \"*.{ts,js,json,css,html}\""
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4060620250520001",
    "@dcloudio/uni-components": "3.0.0-4060620250520001",
    "@dcloudio/uni-h5": "3.0.0-4060620250520001",
    "qrcode": "^1.5.4",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.32",
    "@dcloudio/uni-cli-shared": "3.0.0-4060620250520001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4060620250520001",
    "@dcloudio/vite-plugin-uni": "3.0.0-4060620250520001",
    "@types/qrcode": "^1.5.6",
    "prettier": "^3.4.2",
    "typescript": "^5.9.0",
    "vite": "5.2.8",
    "vue-tsc": "^3.1.0"
  }
}
