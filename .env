# ──────────────────────────────────────────────
# 全环境公共变量（非敏感；密钥/口令禁止加 VITE_ 前缀）
# 业务代码统一从 src/config/env.ts 读取，不直接散落 import.meta.env.VITE_*
# ──────────────────────────────────────────────

# 运行环境标识，development / production 由 .env.[mode] 覆盖
VITE_APP_ENV=development

# 页面标题与品牌兜底文案（品牌最终以 Mock 的 profile 数据为准）
VITE_APP_TITLE=星穹 SkyShow · 无人机编队表演
VITE_BRAND_NAME=星穹 SkyShow

# 接口基地址：静态页阶段不发起真实请求，接入 drone-dispatch-server 时改为 /api
VITE_API_BASE=/api

# H5 dev server 端口（manifest.json 的 h5.devServer.port 必须与之一致）
VITE_DEV_PORT=5174

# 静态 Mock 数据的模拟网络延迟（毫秒）；0 表示即时返回
VITE_MOCK_DELAY=120

# ──────────────────────────────────────────────
# 微信网页授权（H5 登录）
# mock：本地模拟微信授权，不需要公众号资质（开发/演示/自动化默认）
# real：真实跳转微信授权页，需已认证服务号 + 公众平台「网页授权域名」
# ──────────────────────────────────────────────
VITE_WX_AUTH_MODE=mock

# 服务号 AppID（公开标识，不是密钥，可入库）。real 模式必填；
# 留空时前端会自动降级为 mock，避免跳到必然报错的授权链接。AppSecret 只能放后端环境变量。
VITE_WX_APP_ID=wx92d9ecd5c3938902

# 登录用授权作用域。snsapi_base（默认）：静默授权，无弹窗，只拿 openid——
# 登录只需要能认人的标识；昵称头像由用户在「我的」里主动授权（snsapi_userinfo）获取。
# 想让登录时就弹授权页，改成 snsapi_userinfo。
VITE_WX_SCOPE=snsapi_base

# 授权回调基址，必须是公众平台配置的「网页授权域名」下的地址（建议 https）；
# 留空则取当前站点根目录。本地真机联调需配合内网穿透域名。
VITE_WX_REDIRECT_URI=